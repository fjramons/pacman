# Base
NODE_ENV=production
PORT=8080

# Database backend selection: "postgres" (default) or "mongo".
# Only the block matching DB_DRIVER is read at runtime; the other is ignored.
DB_DRIVER=postgres

# PostgreSQL (used when DB_DRIVER=postgres). Standard libpq env var names,
# read natively by the "pg" driver - map 1:1 to the Terraform "postgresql"
# module outputs: db_host/db_port/db_database_name/db_username/db_password.
PGHOST=localhost
PGPORT=5432
PGDATABASE=pacman
PGUSER=
PGPASSWORD=
PGSSLMODE=disable

# MongoDB (used when DB_DRIVER=mongo, preserved for backwards compatibility)
MONGO_SERVICE_HOST=pacman-mongo
MY_MONGO_PORT=27017
MONGO_DATABASE=pacman
MONGO_USE_SSL=false
MONGO_VALIDATE_SSL=true
MONGO_AUTH_USER=
MONGO_AUTH_PWD=
MONGO_REPLICA_SET=
