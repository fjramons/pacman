# For a CI pipeline validating a freshly built image through ArgoCD (pull) rather than "kubectl apply -k" (push): regenerate with envsubst in the pipeline's own job, apply, wait for sync, then delete once validation is done. Only this .template is tracked, never a committed pacman-application.yaml.
#
# source.path points at overlays/all-in-one (self-contained, bundles its own Postgres), not overlays/dev, so this validation needs no external infrastructure. source.kustomize.images pins the image this same run just built and pushed.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: pacman-ci
  namespace: argocd
spec:
  project: default
  source:
    repoURL: ${CI_PROJECT_URL}.git
    targetRevision: ${CI_COMMIT_SHA}
    path: k8s/kustomize/overlays/all-in-one
    kustomize:
      images:
        - pacman=${IMAGE_REGISTRY}/pacman:${CI_COMMIT_SHORT_SHA}
  destination:
    server: https://kubernetes.default.svc
    namespace: pacman
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
