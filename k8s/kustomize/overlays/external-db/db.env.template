# Not applied directly: envsubst this into db.env (gitignored). Alternative to copying db.env.example by hand, for automation that already has these values as environment variables.
#
#   PGHOST=... PGPORT=... PGDATABASE=... envsubst < db.env.template > db.env
PGHOST=${PGHOST}
PGPORT=${PGPORT}
PGDATABASE=${PGDATABASE}
PGSSLMODE=disable
